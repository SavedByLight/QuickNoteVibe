# Copy this file to keystore.properties and fill in real values.
# keystore.properties is gitignored — never commit real passwords or the .jks file.
#
# storeFile can be absolute or relative to the project root (this file's directory).
storeFile=quicknotevibe-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=quicknotevibe
keyPassword=YOUR_KEY_PASSWORD
