<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Title"
        android:inputType="textCapSentences"
        android:textSize="22sp" />

    <EditText
        android:id="@+id/etFilename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="GitHub file name (e.g. meeting-notes)"
        android:inputType="text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved on GitHub as notes/&lt;name&gt;.md"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingBottom="4dp" />

    <!-- Formatting toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBold"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Bold" />

            <Button
                android:id="@+id/btnItalic"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Italic" />

            <Button
                android:id="@+id/btnUnderline"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="U"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Underline" />

            <Button
                android:id="@+id/btnCode"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="&lt;/&gt;"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Inline code" />

            <Button
                android:id="@+id/btnCodeBlock"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:text="{ }"
                android:textSize="14sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Code block" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="6dp"
                android:background="#CCCCCC" />

            <Button
                android:id="@+id/btnH1"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="H1"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Heading 1" />

            <Button
                android:id="@+id/btnH2"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="H2"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Heading 2" />

            <Button
                android:id="@+id/btnH3"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="H3"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Heading 3" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="6dp"
                android:background="#CCCCCC" />

            <Button
                android:id="@+id/btnSizeUp"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="A+"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Increase text size" />

            <Button
                android:id="@+id/btnSizeDown"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:text="A-"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="Decrease text size" />

        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/etBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:hint="Write your note…"
        android:inputType="textMultiLine"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete" />
        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_save"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save" />
    </LinearLayout>
</LinearLayout>
